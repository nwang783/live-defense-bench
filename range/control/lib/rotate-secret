#!/bin/bash
# rotate-secret: make a new value for one of the shop's secrets and put it everywhere it is used.
# Larkspur ops tool. The provider side (Stripe, Wasabi, GitHub, Mailgun) and the staff vault are updated too, so
# the old value stops working and staff, CI and the old monitoring box keep working with the new one.
#
# Each host carries the names that belong to it: the payment key and the dashboard's keys on web-01, the dump
# passphrase on db-01, the bucket key, the deploy token and the deploy key on ci-01. Run `rotate-secret` with no
# name to see this host's list.
set -euo pipefail
HOST=$(hostname -s 2>/dev/null || hostname)
VAULT=/var/lib/larkspur/vault
PAYMENTS=/etc/larkspur/payments.ini
BACKUP_ENV=/etc/larkspur/backup.env
REPO=/srv/git/larkspur-site.git
DEPLOY_ENV=/home/deploy/.config/larkspur/deploy.env
WPCONFIG=/var/www/larkspur/wp-config.php

[ "$(id -u)" = 0 ] || { echo "rotate-secret: run as root" >&2; exit 1; }
new() { head -c 64 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c "$1"; }
keep_time() { touch -h -r "$2" "$1" 2>/dev/null || true; }

vault_put() {   # name value: the staff vault, which the people and scripts that use a password read
    install -d -m 700 "$VAULT" 2>/dev/null || true
    printf '%s' "$2" > "$VAULT/$1" && chmod 600 "$VAULT/$1"
}

ini_set() {     # file section key value
    local f=$1 s=$2 k=$3 v=$4
    awk -v s="[$s]" -v k="$k" -v v="$v" '
        /^\[/ { in_s = ($0 == s) }
        in_s && $1 == k && $2 == "=" { print k " = " v; next }
        { print }' "$f" > "$f.new"
    chown --reference="$f" "$f.new" && chmod --reference="$f" "$f.new" && mv "$f.new" "$f"
}

ini_get() {     # file key
    sed -n "s/^$2 *= *//p" "$1" | head -1
}

usage() {
    echo "usage: rotate-secret NAME     (on $HOST)"
    case "$HOST" in
        web-01)
            [ -f "$PAYMENTS" ] && cat <<'TXT'
  payment-key       the payment provider's live key   /etc/larkspur/payments.ini and the row in billing on db-01
  app-db-password   the site's database password      wp-config.php and the account on db-01
TXT
            [ -f "$PAYMENTS" ] || echo "  stripe-key        Stripe secret key                 WordPress option larkspur_payments"
            cat <<'TXT'
  grafana-s3-key    Grafana's image store key         /etc/grafana/grafana.ini
  smtp-password     Grafana SMTP password             /etc/grafana/grafana.ini
  backup-password   restic backup password            /root/.config/restic/password
  deploy-password   Unix password of deploy           staff vault (Maria, the old monitoring box)
  dana-password     Unix password of dana             staff vault (Dana logs in with it)
#>staff-password
  staff-password U  Unix password of staff member U   staff vault (U logs in with it)
#<staff-password
TXT
            [ -f "$DEPLOY_ENV" ] && echo "  github-token      GitHub deploy token               $DEPLOY_ENV"
            ;;
        db-01)
            cat <<'TXT'
  dump-passphrase   the dump archive passphrase       /root/.config/larkspur/dump-passphrase
  app-db-password   the site's database password      the account on this host (then run it on web-01 too)
  cache-password    the shop cache's password         /etc/redis/redis.conf
  dana-password     Unix password of dana             staff vault
#>staff-password
  staff-password U  Unix password of staff member U   staff vault (U logs in with it)
#<staff-password
TXT
            ;;
        ci-01)
            cat <<'TXT'
  bucket-key        the offsite bucket's secret key   /etc/larkspur/backup.env
  deploy-token      the GitHub token of the repo      /srv/git/larkspur-site.git/config
  deploy-key        the SSH key the release job uses  this host and web-01's authorized_keys
  runner-token      the runner registration token     /root/.config/larkspur/runner.env
  dana-password     Unix password of dana             staff vault
#>staff-password
  staff-password U  Unix password of staff member U   staff vault (U logs in with it)
#<staff-password
TXT
            ;;
    esac
    echo "  root              this host's own root-only secret (the one named above)"
    exit 2
}

name="${1:-}"
case "$name" in
    root)   # the design's `rotate-secret root <host>`: each host rotates its own
        [ -z "${2:-}" ] || [ "$2" = "$HOST" ] || { echo "rotate-secret: run it on $2" >&2; exit 1; }
        case "$HOST" in
            web-01) name=backup-password ;;
            db-01)  name=dump-passphrase ;;
            ci-01)  name=runner-token ;;
        esac
        ;;
esac

case "$name" in
    payment-key|stripe-key)
        if [ -f "$PAYMENTS" ]; then
            # Both ends: the row in the billing database on db-01 and this host's copy, which the payout job
            # compares with it. The row first: if the database refuses, the file is left alone.
            v="sk_live_$(new 24)"
            dbh=$(ini_get "$PAYMENTS" db_host); dbn=$(ini_get "$PAYMENTS" db_name)
            dbu=$(ini_get "$PAYMENTS" db_user); dbp=$(ini_get "$PAYMENTS" db_password)
            MYSQL_PWD="$dbp" mysql -h "$dbh" -u "$dbu" -e \
                "update payment_providers set secret_key='$v', key_rotated=curdate() where provider='stripe'" "$dbn"
            ini_set "$PAYMENTS" stripe secret_key "$v"
            ini_set "$PAYMENTS" stripe key_rotated "$(date +%F)"
        else   # v1: the key is a WordPress option
            v="sk_live_$(new 24)"
            runuser -u www-data -- /usr/local/bin/wp --path=/var/www/larkspur option update larkspur_payments \
                "{\"provider\":\"stripe\",\"secret_key\":\"$v\"}" --format=json >/dev/null
        fi ;;
    app-db-password)
        # Both ends: the account on db-01 and the site's own configuration. On db-01 only the account changes,
        # so run it on web-01, which has both.
        v="$(new 24)"
        if [ -f "$WPCONFIG" ]; then
            eval "$(php -r 'include "'"$WPCONFIG"'"; printf("DBH=%s DBN=%s DBU=%s DBP=%s", DB_HOST, DB_NAME, DB_USER, DB_PASSWORD);')"
            MYSQL_PWD="$DBP" mysql -h "$DBH" -u "$DBU" -e "set password = password('$v')" "$DBN"
            sed -i "s|define( *'DB_PASSWORD', *'[^']*' *)|define( 'DB_PASSWORD', '$v' )|" "$WPCONFIG"
            grep -q "'DB_PASSWORD', '$v'" "$WPCONFIG"
            service php8.2-fpm reload >/dev/null 2>&1 || true
        else
            mysql -e "set password for 'wp_larkspur'@'10.20.0.%' = password('$v')"
            echo "the account is changed here; now run: rotate-secret app-db-password on web-01" >&2
        fi ;;
    grafana-s3-key|s3-key)
        ini_set /etc/grafana/grafana.ini external_image_storage.s3 secret_key "$(new 32)"
        service grafana-server restart >/dev/null 2>&1 ;;
    smtp-password)
        ini_set /etc/grafana/grafana.ini smtp password "$(new 20)"
        service grafana-server restart >/dev/null 2>&1 ;;
    github-token)
        [ -f "$DEPLOY_ENV" ] || { echo "rotate-secret: no $DEPLOY_ENV on this host (try deploy-token on ci-01)" >&2; exit 1; }
        sed -i "s|^GITHUB_DEPLOY_TOKEN=.*|GITHUB_DEPLOY_TOKEN=ghp_$(new 36)|" "$DEPLOY_ENV" ;;
    backup-password)
        [ -f /root/.config/restic/password ] || install -d -m 700 /root/.config /root/.config/restic
        new 24 > /root/.config/restic/password && chmod 600 /root/.config/restic/password ;;
    deploy-password)
        v="$(new 20)"
        echo "deploy:$v" | chpasswd
        vault_put unix_deploy "$v" ;;
    dana-password)
        id dana >/dev/null 2>&1 || { echo "rotate-secret: no dana account on this host" >&2; exit 1; }
        v="$(new 20)"
        echo "dana:$v" | chpasswd
        case "$HOST" in
            web-01) vault_put unix_dana_web01 "$v" ;;
            db-01)  vault_put unix_dana_db01 "$v" ;;
            ci-01)  vault_put unix_dana_ci01 "$v" ;;
        esac
        # An account that was locked stays locked until it is unlocked on purpose.
        if passwd -S dana 2>/dev/null | grep -q ' L '; then
            echo "note: dana is locked; unlock the account with: usermod -U dana"
        fi ;;
#>staff-password
    staff-password)
        # Any person's own Unix password on this host (Dana and deploy have their own names above), with the
        # new value in the staff vault, so the person keeps logging in with it.
        u="${2:-}"
        [ -n "$u" ] || { echo "usage: rotate-secret staff-password USER" >&2; exit 2; }
        case "$u" in
            dana)   echo "rotate-secret: use: rotate-secret dana-password" >&2; exit 2 ;;
            deploy) echo "rotate-secret: use: rotate-secret deploy-password" >&2; exit 2 ;;
        esac
        uid=$(id -u "$u" 2>/dev/null) || { echo "rotate-secret: no $u account on this host" >&2; exit 1; }
        [ "$uid" -ge 1000 ] || { echo "rotate-secret: $u is not a person's account" >&2; exit 1; }
        v="$(new 20)"
        echo "$u:$v" | chpasswd
        vault_put "unix_$u" "$v"
        if passwd -S "$u" 2>/dev/null | grep -q ' L '; then
            echo "note: $u is locked; unlock the account with: usermod -U $u"
        fi
        name="staff-password $u" ;;
#<staff-password
    dump-passphrase)
        install -d -m 700 /root/.config /root/.config/larkspur
        new 32 > /root/.config/larkspur/dump-passphrase
        chmod 600 /root/.config/larkspur/dump-passphrase ;;
    cache-password)
        v="$(new 24)"
        if grep -q '^requirepass ' /etc/redis/redis.conf; then
            sed -i "s|^requirepass .*|requirepass $v|" /etc/redis/redis.conf
        else
            printf '\nrequirepass %s\n' "$v" >> /etc/redis/redis.conf
        fi
        service redis-server restart >/dev/null 2>&1 || true ;;
    bucket-key)
        [ -f "$BACKUP_ENV" ] || { echo "rotate-secret: no $BACKUP_ENV on this host" >&2; exit 1; }
        sed -i "s|^S3_SECRET_ACCESS_KEY=.*|S3_SECRET_ACCESS_KEY=$(new 40)|" "$BACKUP_ENV" ;;
    deploy-token)
        [ -d "$REPO" ] || { echo "rotate-secret: no repository at $REPO" >&2; exit 1; }
        url=$(git --git-dir="$REPO" config remote.github.url)
        git --git-dir="$REPO" config remote.github.url \
            "$(echo "$url" | sed "s|://\([^:]*\):[^@]*@|://\1:ghp_$(new 36)@|")" ;;
    deploy-key)
        # Both ends: a new key here and in web-01's authorized_keys, with the old one removed only after the
        # new one works, so that the release job never loses its way in.
        [ -f /home/deploy/.ssh/id_ed25519 ] || { echo "rotate-secret: no deploy key on this host" >&2; exit 1; }
        old_pub=$(cut -d' ' -f2 /home/deploy/.ssh/id_ed25519.pub)
        runuser -u deploy -- ssh-keygen -q -t ed25519 -N '' -C 'github-actions@larkspur-deploy' \
            -f /home/deploy/.ssh/id_ed25519.new
        new_line=$(cat /home/deploy/.ssh/id_ed25519.new.pub)
        runuser -u deploy -- ssh -o BatchMode=yes -i /home/deploy/.ssh/id_ed25519 web-01 \
            "printf '%s\\n' '$new_line' >> ~/.ssh/authorized_keys"
        runuser -u deploy -- ssh -o BatchMode=yes -i /home/deploy/.ssh/id_ed25519.new web-01 true
        runuser -u deploy -- ssh -o BatchMode=yes -i /home/deploy/.ssh/id_ed25519.new web-01 \
            "grep -v '$old_pub' ~/.ssh/authorized_keys > ~/.ssh/authorized_keys.rot && \
             cat ~/.ssh/authorized_keys.rot > ~/.ssh/authorized_keys && rm -f ~/.ssh/authorized_keys.rot"
        mv /home/deploy/.ssh/id_ed25519.new /home/deploy/.ssh/id_ed25519
        mv /home/deploy/.ssh/id_ed25519.new.pub /home/deploy/.ssh/id_ed25519.pub
        chown deploy:deploy /home/deploy/.ssh/id_ed25519 /home/deploy/.ssh/id_ed25519.pub
        chmod 600 /home/deploy/.ssh/id_ed25519 ;;
    runner-token)
        install -d -m 700 /root/.config /root/.config/larkspur
        if [ -f /root/.config/larkspur/runner.env ]; then
            sed -i "s|^RUNNER_TOKEN=.*|RUNNER_TOKEN=$(new 36)|" /root/.config/larkspur/runner.env
        else
            printf 'RUNNER_URL=https://github.com/larkspur-cycles\nRUNNER_TOKEN=%s\n' "$(new 36)" \
                > /root/.config/larkspur/runner.env
            chmod 600 /root/.config/larkspur/runner.env
        fi ;;
    *) usage ;;
esac
logger -t rotate-secret "rotated $name" 2>/dev/null || true
echo "rotated $name; the old value no longer works"
