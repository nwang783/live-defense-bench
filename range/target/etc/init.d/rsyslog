#!/bin/sh
### BEGIN INIT INFO
# Provides:          rsyslog
# Required-Start:    $remote_fs $time
# Required-Stop:     umountnfs $time
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: enhanced syslogd
### END INIT INFO
PIDFILE=/run/rsyslogd.pid
case "$1" in
  start) echo "Starting enhanced syslogd: rsyslogd."; start-stop-daemon --start --quiet --pidfile $PIDFILE --exec /usr/sbin/rsyslogd ;;
  stop) echo "Stopping enhanced syslogd: rsyslogd."; start-stop-daemon --stop --quiet --retry 5 --pidfile $PIDFILE --exec /usr/sbin/rsyslogd; rm -f $PIDFILE ;;
  restart) $0 stop; $0 start ;;
  reload|force-reload|rotate) start-stop-daemon --stop --signal HUP --quiet --pidfile $PIDFILE --exec /usr/sbin/rsyslogd ;;
  status) [ -f $PIDFILE ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null && echo "rsyslogd is running." || { echo "rsyslogd is not running."; exit 3; } ;;
  *) echo "Usage: /etc/init.d/rsyslog {start|stop|restart|reload|status}"; exit 1 ;;
esac
