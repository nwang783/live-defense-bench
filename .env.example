# Copy to .env at the repository root and fill in what you need. Never commit .env.
# A scripted defender (script:none, script:perfect, script:blunt) on the Docker backend needs nothing here.

# The range image for the Docker backend (default: ldb-range:local, the tag of the README's build command).
KL_RANGE_IMAGE_V2=

# Defender anthropic:<model> (direct API harness).
ANTHROPIC_API_KEY=
# Defender openai:<model> (or openai:<model>@<base_url>#<KEY_ENV> for another OpenAI-compatible endpoint).
OPENAI_API_KEY=
# Defender meta:<model>.
META_API_KEY=

# Defender claude-code:<model> and codex:<model> use your own logged-in Claude Code or Codex CLI, not a key.
# Optional: the claude binary, and folders to search for codex before PATH.
KL_CLAUDE_BIN=
KL_CODEX_BIN_DIR=
# Optional provider access program flag: extra Codex arguments that turn on an access program that your
# provider gave your account. Empty (the default) means standard access.
KL_CODEX_ACCESS_ARGS=

# Optional Blaxel backend: your own Blaxel account and your own build of the range image.
BL_WORKSPACE=
BL_API_KEY=
KL_BLAXEL_IMAGE_V2=

# Optional trace export to your own Langfuse project. Off unless KL_LANGFUSE=1.
KL_LANGFUSE=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
